{
  "compilerOptions": {
    "baseUrl": ".",
    "sourceMap": false,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "allowJs": false,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "removeComments": false,
    "jsx": "preserve",
    "importHelpers": true,
    "lib": ["esnext", "dom"],
    "types": [
      "@mastergo/plugin-typings",
      "node"
    ],
    "paths": {
      "@lib/*": ["./src/plugin/*"],
      "@ui/*": ["../src/ui/*"],
      "@messages/*": ["../src/messages/*"],
      "@/*": ["../src/*"],
      "@/plugin/*": ["./src/plugin/*"],
      "@/messages/*": ["../src/messages/*"],
      "@/config/*": ["../src/config/*"],
      "@shared-ui/*": ["../../shared-ui/*"]
    }
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.vue",
    "../src/ui/**/*.ts",
    "../src/ui/**/*.vue",
    "../../shared-ui/**/*.ts",
    "../../shared-ui/**/*.vue",
    "./typings/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
