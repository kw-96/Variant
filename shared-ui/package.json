{
  "name": "@variant/shared-ui",
  "version": "1.0.0",
  "description": "共享UI组件库 - 基于GitHub配色方案的Vue组件库",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts,.vue",
    "test": "jest"
  },
  "keywords": [
    "vue",
    "ui",
    "components",
    "theme",
    "github",
    "design-system"
  ],
  "author": "Variant Team",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "components/",
    "styles/",
    "hooks/",
    "utils/",
    "types/",
    "index.js",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.js",
      "types": "./index.d.ts"
    },
    "./styles": {
      "import": "./styles/index.css",
      "require": "./styles/index.css"
    },
    "./hooks": {
      "import": "./hooks/index.js",
      "require": "./hooks/index.js",
      "types": "./hooks/index.d.ts"
    },
    "./utils": {
      "import": "./utils/index.js",
      "require": "./utils/index.js",
      "types": "./utils/index.d.ts"
    }
  }
}
