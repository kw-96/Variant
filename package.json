{
  "name": "variant",
  "version": "1.0.0",
  "description": "Variant - Multi-functional design tools collection for Figma and MasterGo",
  "private": true,
  "workspaces": [
    "Variant/src",
    "Variant/figma",
    "Variant/mastergo"
  ],
  "scripts": {
    "dev": "npm run dev:variant",
    "dev:variant": "npm run dev:variant:figma & npm run dev:variant:mastergo",
    "dev:variant:figma": "cd Variant/figma && npm run dev",
    "dev:variant:mastergo": "cd Variant/mastergo && npm run dev",
    "build": "npm run build:variant",
    "build:variant": "npm run build:variant:figma && npm run build:variant:mastergo",
    "build:variant:figma": "cd Variant/figma && npm run build",
    "build:variant:mastergo": "cd Variant/mastergo && npm run build",
    "install:all": "npm install && cd Variant/src && npm install && cd ../figma && npm install && cd ../mastergo && npm install",
    "clean": "rm -rf node_modules Variant/*/node_modules",
    "lint": "npm run lint:variant",
    "lint:variant": "cd Variant/src && npm run lint"
  },
  "dependencies": {
    "@vueuse/core": "^12.5.0",
    "pinia": "^2.3.1",
    "vant": "4.9.15",
    "vue": "^3.2.31",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.7",
    "@babel/preset-typescript": "^7.26.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@mastergo/plugin-typings": "^2.2.0",
    "@types/node": "^17.0.21",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "@vant/auto-import-resolver": "^1.2.1",
    "@vitejs/plugin-vue": "^2.2.4",
    "babel-loader": "^9.2.1",
    "cross-env": "^7.0.3",
    "css-loader": "6.8.1",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.26.0",
    "html-webpack-plugin": "^5.6.3",
    "less": "3.11.1",
    "less-loader": "11.1.4",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.4.35",
    "postcss-html": "^1.7.0",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.2.4",
    "react-dev-utils": "^12.0.1",
    "style-loader": "3.3.3",
    "stylelint-config-recess-order": "^5.0.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-less": "^3.0.1",
    "stylelint-less": "^3.0.1",
    "stylelint-prettier": "^5.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.3.2",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^2.8.6",
    "vite-plugin-singlefile": "^0.7.1",
    "vue-loader": "^17.4.2",
    "webpack": "5.88.2",
    "webpack-cli": "5.1.4"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
